
menuconfig PAW3222
    bool "PAW3222 mouse optical sensor"
  select SPI
    help
      Enable PAW3222 mouse optical sensor.

if PAW3222

config PAW3222_POINTER_ACCELERATION
    bool "PAW3222 same-frame pointer acceleration support"
    default n
    help
      Allow an opted-in PAW3222 node to apply a vector-based gain curve to
      each complete X/Y report frame. Nodes without the Devicetree opt-in keep
      the original linear path.

endif
